# Apple code signing and notarization (for local builds)
# Copy to .env.local and fill in your values

# Your Apple ID (must be added to the XMTP team in App Store Connect)
APPLE_ID=your@email.com

# App-specific password from https://appleid.apple.com
# Sign-In and Security → App-Specific Passwords
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team ID (get from team admin or Apple Developer portal)
APPLE_TEAM_ID=XXXXXXXXXX

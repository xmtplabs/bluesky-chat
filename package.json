{
  "name": "bluesky-chat",
  "version": "1.0.2-beta.0",
  "type": "module",
  "description": "Electron desktop chat app with Bluesky identity and XMTP encryption",
  "author": "XMTP Labs <info@xmtp.org>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node node_modules/electron/install.js",
    "pack": "electron-builder --dir",
    "dist": "dotenv -e .env.local -- electron-builder",
    "dist:beta": "npm version prerelease --preid=beta --no-git-tag-version && dotenv -e .env.local -- electron-builder",
    "dist:prod": "dotenv -e .env.local -- electron-builder",
    "release:beta": "npm version prerelease --preid=beta && git push --follow-tags",
    "release:beta:minor": "npm version preminor --preid=beta && git push --follow-tags",
    "release:beta:major": "npm version premajor --preid=beta && git push --follow-tags",
    "release": "npm version patch && git push --follow-tags",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules out dist"
  },
  "dependencies": {
    "@atproto/api": "0.15.5",
    "@atproto/oauth-client-browser": "^0.3.9",
    "@atproto/oauth-types": "^0.6.2",
    "@tanstack/react-virtual": "^3.13.18",
    "@xmtp/browser-sdk": "6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.23.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.0.18"
  }
}
